# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/codek-platform?retryWrites=true&w=majority

# Random 128-char hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_strong_random_secret

PORT=5000
NODE_ENV=development

# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EmailJS keys (used by frontend contact form)
REACT_APP_EMAILJS_SERVICE=service_xxxxxxx
REACT_APP_EMAILJS_TEMPLATE=template_xxxxxxx
REACT_APP_EMAILJS_PUBLIC=xxxxxxxxxxxxxxxxx
