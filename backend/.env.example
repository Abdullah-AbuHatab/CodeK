# Copy to backend/.env for local development. Never commit the real file.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# The server starts even when this is unreachable and keeps retrying.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/codek-platform?retryWrites=true&w=majority

# Random 128-char hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start without it.
JWT_SECRET=replace_me_with_a_strong_random_secret

PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed by CORS. Only needed when
# the frontend runs on another origin (e.g. the CRA dev server on :3000);
# the monolith deployment is same-origin.
ALLOWED_ORIGINS=http://localhost:3000

# Admin user created/updated by `npm run seed` (all three or none).
# ADMIN_PASSWORD must be at least 12 characters. Optional: ADMIN_FULLNAME,
# ADMIN_PHONE. The running server never reads these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_FULLNAME=Admin User
ADMIN_EMAIL=admin@example.com

# Rate limiting (all optional — sane defaults are baked in)
# Auth: 10 *failed* attempts per 15 minutes per IP. Successful logins are
# not counted, so a real user can't lock themselves out.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# AI chat: 30 requests per minute per IP.
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
# Generic API ceiling: 300 requests per 15 minutes per IP.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
# Contact form: 5 messages per 15 minutes per IP.
RATE_LIMIT_CONTACT_WINDOW_MS=900000
RATE_LIMIT_CONTACT_MAX=5

# AI tutor (OpenRouter). Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Vendor-prefixed model id from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Comma-separated fallbacks, tried in order (OpenRouter `models` routing) when
# the primary errors, is rate-limited or retired. Empty = primary only.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# How long to wait for the model before answering 504 AI_TIMEOUT.
CHAT_TIMEOUT_MS=20000
# "true" requires a logged-in user (JWT) for /api/chat. Default: false.
CHAT_REQUIRE_AUTH=false

# Contact form e-mail via Brevo (optional — complaints are always saved to
# the database; e-mail is best-effort).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CodeK Support
CONTACT_RECIPIENT_EMAIL=
